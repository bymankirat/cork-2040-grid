{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "demandLine",
  "position": {
    "x": 20,
    "y": 210,
    "z": 10000,
    "width": 610,
    "height": 490,
    "tabOrder": 10000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_year"
                    }
                  },
                  "Property": "Year"
                }
              },
              "queryRef": "dim_year.Year",
              "nativeQueryRef": "Year",
              "displayName": "Year"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Peak MW"
                }
              },
              "queryRef": "_Measures.Peak MW",
              "nativeQueryRef": "Peak MW",
              "displayName": "Peak MW"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_demand"
                    }
                  },
                  "Property": "Scenario"
                }
              },
              "queryRef": "fact_demand.Scenario",
              "nativeQueryRef": "Scenario",
              "displayName": "Scenario"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "dim_year"
                  }
                },
                "Property": "Year"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Winter peak demand by model scenario (MW)'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}