{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "siteMap",
  "position": {
    "x": 20,
    "y": 92,
    "z": 4000,
    "width": 520,
    "height": 608,
    "tabOrder": 4000
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_station"
                    }
                  },
                  "Property": "Station"
                }
              },
              "queryRef": "dim_station.Station",
              "nativeQueryRef": "Station",
              "displayName": "Station"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_station"
                    }
                  },
                  "Property": "Status2040"
                }
              },
              "queryRef": "dim_station.Status2040",
              "nativeQueryRef": "Status2040",
              "displayName": "Status"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "dim_station"
                        }
                      },
                      "Property": "Longitude"
                    }
                  },
                  "Function": 1
                }
              },
              "queryRef": "Avg(dim_station.Longitude)",
              "nativeQueryRef": "Longitude",
              "displayName": "Longitude"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "dim_station"
                        }
                      },
                      "Property": "Latitude"
                    }
                  },
                  "Function": 1
                }
              },
              "queryRef": "Avg(dim_station.Latitude)",
              "nativeQueryRef": "Latitude",
              "displayName": "Latitude"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Shortfall 2040 MW"
                }
              },
              "queryRef": "_Measures.Shortfall 2040 MW",
              "nativeQueryRef": "Shortfall 2040 MW",
              "displayName": "Shortfall MW"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Where the short stations are (bubble = 2040 shortfall)'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#1B8A5A'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "scopeId": {
                  "Comparison": {
                    "ComparisonKind": 0,
                    "Left": {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Entity": "dim_station"
                          }
                        },
                        "Property": "Status2040"
                      }
                    },
                    "Right": {
                      "Literal": {
                        "Value": "'Green'"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#E0A100'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "scopeId": {
                  "Comparison": {
                    "ComparisonKind": 0,
                    "Left": {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Entity": "dim_station"
                          }
                        },
                        "Property": "Status2040"
                      }
                    },
                    "Right": {
                      "Literal": {
                        "Value": "'Amber'"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#C2362F'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "scopeId": {
                  "Comparison": {
                    "ComparisonKind": 0,
                    "Left": {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Entity": "dim_station"
                          }
                        },
                        "Property": "Status2040"
                      }
                    },
                    "Right": {
                      "Literal": {
                        "Value": "'Red'"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "legend": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "position": {
              "expr": {
                "Literal": {
                  "Value": "'Top'"
                }
              }
            }
          }
        }
      ]
    }
  }
}