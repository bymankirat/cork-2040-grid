{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "_Measures",
        "lineageTag": "ec3d9e2a-b5bd-4649-8b4b-432cdecc0243",
        "columns": [
          {
            "name": "Value",
            "dataType": "int64",
            "sourceColumn": "Value",
            "isHidden": true,
            "summarizeBy": "none",
            "lineageTag": "195c99c3-48b4-4abb-8e97-1d343d5af8da"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(type table [Value = Int64.Type], {})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Stations",
            "expression": "DISTINCTCOUNT ( dim_station[StationID] )",
            "lineageTag": "4fa5ff2d-5997-4a9d-8457-0bea5d71a5c6",
            "formatString": "#,0"
          },
          {
            "name": "Stations Short 2040",
            "expression": "CALCULATE ( [Stations], dim_station[Status2040] IN { \"Amber\", \"Red\" } )",
            "lineageTag": "85b607f6-f1fa-4944-bce8-cc9ecbb4a8df",
            "formatString": "#,0"
          },
          {
            "name": "Stations Ready 2040",
            "expression": "CALCULATE ( [Stations], dim_station[Status2040] = \"Green\" )",
            "lineageTag": "5fc1bcc9-765b-433c-81cc-b3ec94709c38",
            "formatString": "#,0"
          },
          {
            "name": "% Ready 2040",
            "expression": "DIVIDE ( [Stations Ready 2040], [Stations] )",
            "lineageTag": "35afcd03-a434-4fa1-a7de-0eca8e602d1f",
            "formatString": "0.0%"
          },
          {
            "name": "New Stations Needed",
            "expression": "CALCULATE ( [Stations], dim_station[Status2040] = \"Red\" )",
            "lineageTag": "3592a234-4ae3-4b3c-95fd-111565624f67",
            "formatString": "#,0"
          },
          {
            "name": "Shortfall 2040 MW",
            "expression": "SUM ( dim_station[Shortfall2040MW] )",
            "lineageTag": "2c77e8d1-6850-4463-97b4-ac9623d47b93",
            "formatString": "#,0"
          },
          {
            "name": "Headroom Now MW",
            "expression": "SUM ( dim_station[HeadroomNowMW] )",
            "lineageTag": "36b9ac26-8cbe-408a-bb4b-08bb50ebde09",
            "formatString": "#,0"
          },
          {
            "name": "Avg Years To Full",
            "expression": [
              "AVERAGEX (",
              "    FILTER ( dim_station, NOT ISBLANK ( dim_station[YearFull] ) ),",
              "    dim_station[YearFull] - 2025",
              ")"
            ],
            "lineageTag": "ceb5f719-0091-4ce0-a4d5-1e28fa31d5f6",
            "formatString": "0.0"
          },
          {
            "name": "Status Colour",
            "expression": [
              "SWITCH (",
              "    SELECTEDVALUE ( dim_station[Status2040] ),",
              "    \"Green\", \"#1B8A5A\",",
              "    \"Amber\", \"#E0A100\",",
              "    \"Red\", \"#C2362F\",",
              "    \"#9AA5B1\"",
              ")"
            ],
            "lineageTag": "5d2615cc-33ac-439e-8802-f03f7cecbc33"
          },
          {
            "name": "ESBN Stations Full",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( fact_esbn_headroom[StationID] ),",
              "    fact_esbn_headroom[IsFull] = 1",
              ")"
            ],
            "lineageTag": "5c2af50c-0140-40f0-a7fa-c7cfe536ad70",
            "formatString": "#,0"
          },
          {
            "name": "ESBN % Full",
            "expression": "DIVIDE ( [ESBN Stations Full], DISTINCTCOUNT ( fact_esbn_headroom[StationID] ) )",
            "lineageTag": "74d56a84-2e51-4861-9dc5-36ff4e030015",
            "formatString": "0.0%"
          },
          {
            "name": "ESBN Headroom MW",
            "expression": "SUM ( fact_esbn_headroom[HeadroomMW] )",
            "lineageTag": "96bd5f9a-1f12-461e-a3d7-443529f09f98",
            "formatString": "0.0"
          },
          {
            "name": "ESBN First Year Full",
            "expression": "CALCULATE ( MIN ( fact_esbn_headroom[Year] ), fact_esbn_headroom[IsFull] = 1 )",
            "lineageTag": "7371972b-352e-4eb8-800e-70b80a230e0d",
            "formatString": "0"
          },
          {
            "name": "Peak MW",
            "expression": "SUM ( fact_demand[MW] )",
            "lineageTag": "4f832999-0a55-4570-b62f-ce5804332c15",
            "formatString": "#,0"
          },
          {
            "name": "Peak 2025 MW",
            "expression": "CALCULATE ( [Peak MW], dim_year[Year] = 2025 )",
            "lineageTag": "556e56d8-e692-4489-ad63-8976b921ece0",
            "formatString": "#,0"
          },
          {
            "name": "Peak 2040 MW",
            "expression": "CALCULATE ( [Peak MW], dim_year[Year] = 2040 )",
            "lineageTag": "4e106ee4-4738-44f8-a1c4-e4eb9562af30",
            "formatString": "#,0"
          },
          {
            "name": "Peak Growth %",
            "expression": "DIVIDE ( [Peak 2040 MW] - [Peak 2025 MW], [Peak 2025 MW] )",
            "lineageTag": "ea6a5506-4757-4f4a-8c37-54f769accf65",
            "formatString": "0.0%"
          },
          {
            "name": "Extra Demand MW",
            "expression": "CALCULATE ( [Peak MW], fact_demand[Driver] <> \"Existing demand\" )",
            "lineageTag": "2c026543-6866-4688-9b8c-19ee5269c42d",
            "formatString": "#,0"
          },
          {
            "name": "Driver Share %",
            "expression": "DIVIDE ( [Extra Demand MW], CALCULATE ( [Extra Demand MW], ALL ( fact_demand[Driver] ) ) )",
            "lineageTag": "9b581128-2a5b-4fb7-af0c-55fea86c2031",
            "formatString": "0.0%"
          },
          {
            "name": "Cost P10 EURm",
            "expression": "IF ( HASONEVALUE ( dim_county[County] ), CALCULATE ( SUM ( fact_cost[CostEURm] ), fact_cost[Percentile] = \"P10\" ) )",
            "lineageTag": "47aeb0d2-6f5f-46e8-b5db-cd3589d7f8ba",
            "formatString": "#,0"
          },
          {
            "name": "Cost P50 EURm",
            "expression": "IF ( HASONEVALUE ( dim_county[County] ), CALCULATE ( SUM ( fact_cost[CostEURm] ), fact_cost[Percentile] = \"P50\" ) )",
            "lineageTag": "5cc1a92f-88f8-4386-b488-cf5760fa5a98",
            "formatString": "#,0"
          },
          {
            "name": "Cost P90 EURm",
            "expression": "IF ( HASONEVALUE ( dim_county[County] ), CALCULATE ( SUM ( fact_cost[CostEURm] ), fact_cost[Percentile] = \"P90\" ) )",
            "lineageTag": "45de83f3-67d4-4557-8a2f-59586982107a",
            "formatString": "#,0"
          },
          {
            "name": "Cost Range",
            "expression": [
              "IF (",
              "    HASONEVALUE ( dim_county[County] ),",
              "    \"€\" & FORMAT ( [Cost P10 EURm], \"#,0\" ) & \"m – €\" & FORMAT ( [Cost P90 EURm], \"#,0\" ) & \"m\",",
              "    \"Pick one county\"",
              ")"
            ],
            "lineageTag": "e4d085b9-ad27-4c05-8829-9664da43cfe8"
          },
          {
            "name": "Flex Saving EURm",
            "expression": [
              "IF (",
              "    HASONEVALUE ( dim_county[County] ),",
              "    [Cost P50 EURm] - CALCULATE ( SUM ( fact_cost[CostWithFlexEURm] ), fact_cost[Percentile] = \"P50\" )",
              ")"
            ],
            "lineageTag": "cf319eb0-e19f-4847-b5df-862ba96ed853",
            "formatString": "#,0"
          },
          {
            "name": "Selected County",
            "expression": "IF ( HASONEVALUE ( dim_county[County] ), VALUES ( dim_county[County] ), \"Cork + Dublin\" )",
            "lineageTag": "0688fffe-3693-4252-ab9c-bfadc6e6ed5c"
          },
          {
            "name": "Page Title",
            "expression": "\"Grid readiness to 2040 · \" & [Selected County]",
            "lineageTag": "f1e93b11-ecad-4915-898f-5f63672c1521"
          },
          {
            "name": "Headroom Colour",
            "expression": [
              "VAR h = [ESBN Headroom MW]",
              "RETURN",
              "    IF ( ISBLANK ( h ), BLANK (),",
              "        IF ( h <= 0, \"#F4C7C3\", IF ( h < 5, \"#FCE8B2\", \"#CDEBD8\" ) ) )"
            ],
            "lineageTag": "75f75f5d-4988-4be1-a8ce-ca3229e18d01"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
