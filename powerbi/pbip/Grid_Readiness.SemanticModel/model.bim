{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "_Measures",
        "lineageTag": "13e9be92-ca7d-45e2-8134-21a012c6cd79",
        "columns": [
          {
            "name": "Value",
            "dataType": "int64",
            "sourceColumn": "Value",
            "isHidden": true,
            "summarizeBy": "none",
            "lineageTag": "72dd1d85-c894-4e3d-886e-bd852ea6a7f4"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(type table [Value = Int64.Type], {})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Stations",
            "expression": "DISTINCTCOUNT ( dim_station[StationID] )",
            "lineageTag": "36a70924-ed4b-44a7-9f9c-fb2c4a45d40e",
            "formatString": "#,0"
          },
          {
            "name": "Stations Short 2040",
            "expression": "CALCULATE ( [Stations], dim_station[Status2040] IN { \"Amber\", \"Red\" } )",
            "lineageTag": "45695689-222c-4eec-bb68-b2a21f21ed98",
            "formatString": "#,0"
          },
          {
            "name": "Stations Ready 2040",
            "expression": "CALCULATE ( [Stations], dim_station[Status2040] = \"Green\" )",
            "lineageTag": "c56b7695-5418-4789-85f4-063621d19386",
            "formatString": "#,0"
          },
          {
            "name": "% Ready 2040",
            "expression": "DIVIDE ( [Stations Ready 2040], [Stations] )",
            "lineageTag": "e95a3696-a796-4778-ac94-ede80f8b4bc8",
            "formatString": "0.0%"
          },
          {
            "name": "New Stations Needed",
            "expression": "CALCULATE ( [Stations], dim_station[Status2040] = \"Red\" )",
            "lineageTag": "d10932f9-95b9-4aa8-bdfb-0df1a38dcbfa",
            "formatString": "#,0"
          },
          {
            "name": "Shortfall 2040 MW",
            "expression": "SUM ( dim_station[Shortfall2040MW] )",
            "lineageTag": "1417ba3d-4993-427a-baac-eb46494e5c34",
            "formatString": "#,0"
          },
          {
            "name": "Headroom Now MW",
            "expression": "SUM ( dim_station[HeadroomNowMW] )",
            "lineageTag": "cf54e8ef-5ee3-417a-96e2-b216724e817d",
            "formatString": "#,0"
          },
          {
            "name": "Avg Years To Full",
            "expression": [
              "AVERAGEX (",
              "    FILTER ( dim_station, NOT ISBLANK ( dim_station[YearFull] ) ),",
              "    dim_station[YearFull] - 2025",
              ")"
            ],
            "lineageTag": "3431149a-2679-4754-adb8-a2d7944dee0e",
            "formatString": "0.0"
          },
          {
            "name": "Status Colour",
            "expression": [
              "SWITCH (",
              "    SELECTEDVALUE ( dim_station[Status2040] ),",
              "    \"Green\", \"#1B8A5A\",",
              "    \"Amber\", \"#E0A100\",",
              "    \"Red\", \"#C2362F\",",
              "    \"#9AA5B1\"",
              ")"
            ],
            "lineageTag": "4c0c72fe-283b-42ea-9609-961c9b2e0407"
          },
          {
            "name": "ESBN Stations Full",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( fact_esbn_headroom[StationID] ),",
              "    fact_esbn_headroom[IsFull] = 1",
              ")"
            ],
            "lineageTag": "f5a3bafd-83e5-4750-a377-bb62a6b7516e",
            "formatString": "#,0"
          },
          {
            "name": "ESBN % Full",
            "expression": "DIVIDE ( [ESBN Stations Full], DISTINCTCOUNT ( fact_esbn_headroom[StationID] ) )",
            "lineageTag": "4b4df5a1-65fd-4fc8-95f0-ae4be7add7d3",
            "formatString": "0.0%"
          },
          {
            "name": "ESBN Headroom MW",
            "expression": "SUM ( fact_esbn_headroom[HeadroomMW] )",
            "lineageTag": "02c14ccd-13a8-4b69-840a-0254178bcb5f",
            "formatString": "0.0"
          },
          {
            "name": "ESBN First Year Full",
            "expression": "CALCULATE ( MIN ( fact_esbn_headroom[Year] ), fact_esbn_headroom[IsFull] = 1 )",
            "lineageTag": "defa71d0-e4b7-42eb-9c44-551ce9e8ca92",
            "formatString": "0"
          },
          {
            "name": "Peak MW",
            "expression": "SUM ( fact_demand[MW] )",
            "lineageTag": "31075e4a-5e9b-42cb-9f82-52ca78ec51f9",
            "formatString": "#,0"
          },
          {
            "name": "Peak 2025 MW",
            "expression": "CALCULATE ( [Peak MW], dim_year[Year] = 2025 )",
            "lineageTag": "922b589d-2c42-40fa-a065-4a17bbe7b8bd",
            "formatString": "#,0"
          },
          {
            "name": "Peak 2040 MW",
            "expression": "CALCULATE ( [Peak MW], dim_year[Year] = 2040 )",
            "lineageTag": "3428c31e-f0bc-474b-a11e-8b862393df20",
            "formatString": "#,0"
          },
          {
            "name": "Peak Growth %",
            "expression": "DIVIDE ( [Peak 2040 MW] - [Peak 2025 MW], [Peak 2025 MW] )",
            "lineageTag": "7d764199-49f7-46ca-8b31-df269d001e5e",
            "formatString": "0.0%"
          },
          {
            "name": "Extra Demand MW",
            "expression": "CALCULATE ( [Peak MW], KEEPFILTERS ( fact_demand[Driver] <> \"Existing demand\" ) )",
            "lineageTag": "1a1eede9-ac80-4d2b-85a0-5c124c5c1382",
            "formatString": "#,0"
          },
          {
            "name": "Driver Share %",
            "expression": "DIVIDE ( [Extra Demand MW], CALCULATE ( [Extra Demand MW], ALL ( fact_demand[Driver] ) ) )",
            "lineageTag": "ef37f858-cac8-4e1f-8cf8-5101b6346ed4",
            "formatString": "0.0%"
          },
          {
            "name": "Cost P10 EURm",
            "expression": "IF ( HASONEVALUE ( dim_county[County] ), CALCULATE ( SUM ( fact_cost[CostEURm] ), fact_cost[Percentile] = \"P10\" ) )",
            "lineageTag": "c17b7c82-9007-420a-83f5-481d824708f4",
            "formatString": "#,0"
          },
          {
            "name": "Cost P50 EURm",
            "expression": "IF ( HASONEVALUE ( dim_county[County] ), CALCULATE ( SUM ( fact_cost[CostEURm] ), fact_cost[Percentile] = \"P50\" ) )",
            "lineageTag": "c8ddee60-98bc-4f5b-a02f-8b1472902257",
            "formatString": "#,0"
          },
          {
            "name": "Cost P90 EURm",
            "expression": "IF ( HASONEVALUE ( dim_county[County] ), CALCULATE ( SUM ( fact_cost[CostEURm] ), fact_cost[Percentile] = \"P90\" ) )",
            "lineageTag": "a8951b75-c6a5-4cd0-ae8e-5b576fa95874",
            "formatString": "#,0"
          },
          {
            "name": "Cost Range",
            "expression": [
              "IF (",
              "    HASONEVALUE ( dim_county[County] ),",
              "    \"€\" & FORMAT ( [Cost P10 EURm], \"#,0\" ) & \"m – €\" & FORMAT ( [Cost P90 EURm], \"#,0\" ) & \"m\",",
              "    \"Pick one county\"",
              ")"
            ],
            "lineageTag": "e57c72f0-7066-4fbf-8114-c4b91ec38e44"
          },
          {
            "name": "Flex Saving EURm",
            "expression": [
              "IF (",
              "    HASONEVALUE ( dim_county[County] ),",
              "    [Cost P50 EURm] - CALCULATE ( SUM ( fact_cost[CostWithFlexEURm] ), fact_cost[Percentile] = \"P50\" )",
              ")"
            ],
            "lineageTag": "37e77993-b875-4dc5-b7a0-34965c0f9e21",
            "formatString": "#,0"
          },
          {
            "name": "Selected County",
            "expression": "IF ( HASONEVALUE ( dim_county[County] ), VALUES ( dim_county[County] ), \"Cork + Dublin\" )",
            "lineageTag": "149bf6a3-3ba1-48e9-9ddb-5bacb4f63eb1"
          },
          {
            "name": "Page Title",
            "expression": "\"Grid readiness to 2040 · \" & [Selected County]",
            "lineageTag": "5772b44f-6704-48c8-a899-4b6d5240d3cd"
          },
          {
            "name": "Headroom Colour",
            "expression": [
              "VAR h = [ESBN Headroom MW]",
              "RETURN",
              "    IF ( ISBLANK ( h ), BLANK (),",
              "        IF ( h <= 0, \"#F4C7C3\", IF ( h < 5, \"#FCE8B2\", \"#CDEBD8\" ) ) )"
            ],
            "lineageTag": "48af4a72-bda3-4541-a5c4-58083311f609"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
